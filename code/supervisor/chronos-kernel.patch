+static int handle_rdtsc(struct kvm_vcpu *vcpu) 
+{   static u64 rdtsc_real;
+    if (!global_tsc_ptr) {
+        rdtsc_real = rdtsc();
+    }
+	else{
+		rdtsc_real = atomic64_read(global_tsc_ptr);
+	}
+	
+    vcpu->arch.regs[VCPU_REGS_RAX] = rdtsc_real & -1u;
+    vcpu->arch.regs[VCPU_REGS_RDX] = (rdtsc_real >> 32) & -1u;
+    
+    return skip_emulated_instruction(vcpu);
+}
