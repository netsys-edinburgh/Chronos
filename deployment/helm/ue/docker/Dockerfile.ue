# syntax=docker/dockerfile:1

FROM ubuntu:focal AS ue-build

SHELL ["/bin/bash", "-c"]

ARG BUILD_JOBS=4

RUN apt-get -y update
RUN apt-get -y install net-tools iputils-ping git xxd nano iproute2 iperf3
RUN printf '#!/bin/sh\nprintf "%%s\\n" "%s"\n' "${BUILD_JOBS}" > /usr/local/bin/nproc && \
    chmod +x /usr/local/bin/nproc

COPY --from=oai-source / /openairinterface5g

WORKDIR /openairinterface5g/
RUN source oaienv
WORKDIR /openairinterface5g/cmake_targets/

# Build OAI eNB
RUN DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC ./build_oai -I
WORKDIR /
RUN git clone https://github.com/ujjwalpawar/asn1c.git
RUN apt install -y bison flex
WORKDIR /asn1c
RUN autoreconf -iv
RUN ./configure --prefix /opt/asn1c/
RUN make -j"${BUILD_JOBS}"
RUN make install
WORKDIR /openairinterface5g/cmake_targets/

# Build OAI NR UE using the previous ran_build directory as a cache. Copy only
# runtime artifacts out of the cache so build objects do not become image
# layers.
RUN --mount=type=cache,id=oai-nrue-build,target=/openairinterface5g/cmake_targets/ran_build,sharing=locked \
    source /openairinterface5g/oaienv && \
    ./build_oai --nrUE && \
    rm -rf /opt/ue-artifacts && \
    mkdir -p /opt/ue-artifacts && \
    find /openairinterface5g/cmake_targets/ran_build/build -maxdepth 1 -type f \
      \( -name nr-uesoftmodem -o -name 'lib*.so' \) \
      -exec cp -a {} /opt/ue-artifacts/ \;

FROM ubuntu:focal AS ue-runtime

SHELL ["/bin/bash", "-c"]

ARG SOURCE_COMMIT
ARG SOURCE_DIRTY=false
LABEL org.opencontainers.image.source="https://github.com/andrewferguson/openairinterface-nfapi-netsys" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source-dirty="${SOURCE_DIRTY}"

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive TZ=Etc/UTC apt-get install -y --no-install-recommends \
      gdb \
      iperf3 \
      iproute2 \
      iputils-ping \
      libatlas3-base \
      libconfig9 \
      liblapacke \
      libsctp1 \
      libusb-1.0-0 \
      net-tools \
      netcat-openbsd \
      openssl \
      procps \
      python3 \
      util-linux \
      xxd && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p \
      /openairinterface5g/cmake_targets/ran_build/build \
      /usr/local/lib

COPY --from=ue-build /opt/ue-artifacts/nr-uesoftmodem \
    /openairinterface5g/cmake_targets/ran_build/build/
COPY --from=ue-build /opt/ue-artifacts/lib*.so /usr/local/lib/
COPY --from=ue-build /openairinterface5g/oaienv /openairinterface5g/

RUN ldconfig && \
    ldd /openairinterface5g/cmake_targets/ran_build/build/nr-uesoftmodem | \
      tee /tmp/nr-uesoftmodem-ldd.txt && \
    ! grep -q 'not found' /tmp/nr-uesoftmodem-ldd.txt && \
    rm /tmp/nr-uesoftmodem-ldd.txt

WORKDIR /openairinterface5g/cmake_targets/ran_build/build/
